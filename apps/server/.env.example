# 复制为 .env 后按需填写。所有键名都必须与 src 中实际读取的一致 ——
# 历史上出现过 OLLAMA_HOST / OLLAMA_BASE_URL 这类「配置里写了但代码读的是另一个键」
# 的错位，导致配置默默不生效。
#
# ⚠️ 本文件可以入库（.gitignore 里有 !.env.example）；.env 不入库。

# ── 服务 ─────────────────────────────────────────────────────
PORT=3000

# ── 反代 ─────────────────────────────────────────────────────
# 反代跳数，决定 req.ip。直连填 0（默认，不信任任何代理头）；前面有一层 Nginx 填 1。
# req.ip 同时是**限流键**与写进 refresh_tokens.ip_address 的值：
# 填 0 而后端其实在代理后面 ⇒ 所有用户共用代理 IP 一个限流桶，互相挤爆；
# 填大了（信任了不该信任的跳数）⇒ req.ip 变成客户端可伪造的值，限流可绕过。
# 只接受整数：不要填 true，那等于信任任意 X-Forwarded-For。
TRUST_PROXY_HOPS=0

# ── CORS ─────────────────────────────────────────────────────
# 允许的浏览器来源白名单，逗号分隔，**不要带结尾斜杠**（浏览器发的 Origin 不带）。
# 留空 = 对所有来源开放（仅开发用），服务启动时会打印告警。
# 影响面只有 H5：微信小程序的原生请求不发送 Origin，也不做 CORS 强制，不受影响。
# 例：CORS_ORIGINS=https://app.example.com,http://localhost:10086
CORS_ORIGINS=

# ── 接口限流 ─────────────────────────────────────────────────
# 全局默认额度（每个 IP、每条路由、每个时间窗）。
# 逐条路由的额度是代码里的常量（见 src/config/throttle.config.ts）——
# @Throttle() 的参数在类定义期求值，拿不到 ConfigService，所以不可配置。
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_DEFAULT_TTL_MS=60000

# ── MySQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_workspace
DB_USER=root
DB_PASSWORD=

# 是否打印每条 SQL。**默认关闭**：分析 worker 每 3 秒轮询一次 analysis_tasks、
# 每 30 秒续租一次，加上每个进度事件一次 UPDATE，会把应用日志整个顶掉
# （实测空闲 60 秒产生 26 行日志，全部是 SQL，约 1.1 万字符）。
# 排查 SQL 时打开；后台管家查询仍然不打印，所以看到的都是你关心的语句。
DB_LOGGING=false

# ── JWT ──────────────────────────────────────────────────────
# 必填，且**各自至少 32 位、互不相同** —— 不满足时服务拒绝启动
# （见 src/config/env-validation.ts）。两把相同的密钥会让 7 天的 refresh token
# 可以直接当 access token 用，绕过轮转与重放检测。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 改 JWT_REFRESH_SECRET 会让存量刷新令牌全部失效（所有客户端需重新登录），
# 生产轮换请走「双密钥滚动」，方案见 docs/TODO/TODO.md 的 P2-6。
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
# refresh token 的**唯一**有效期来源：DB 的 expires_at 与 JWT 的 exp 都由它推导。
# 必须带单位（ms/s/m/h/d/w）。不要写裸数字 —— 它在 ms 里按毫秒、在 jsonwebtoken
# 里按秒，相差 1000 倍，服务会直接拒绝启动。
JWT_REFRESH_EXPIRES_IN=7d

# ── 自建模型 API Key 加密（必填）─────────────────────────────
# 缺失或短于 16 位时服务**拒绝启动**：它用于加密用户自建模型的 API Key，
# 若退化为进程内随机密钥，已加密的密文在下次重启后将永久无法解密。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MODEL_API_KEY_ENCRYPTION_KEY=

# ── 内置模型厂商密钥 ─────────────────────────────────────────
# openai_compatible 协议（OpenAI / DeepSeek / Qwen 等）
OPENAI_API_KEY=
# Anthropic 协议
ANTHROPIC_API_KEY=
# 本地 Ollama 基地址
OLLAMA_BASE_URL=http://localhost:11434

# ── 微信小程序登录 ───────────────────────────────────────────
WECHAT_APPID=
WECHAT_SECRET=
